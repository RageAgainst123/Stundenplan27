# Audit C-9 (2026-07): friert die Projekt-Konventionen editor-übergreifend
# ein — vorher hielten sich Tabs nur durch Disziplin (CLAUDE.md).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
